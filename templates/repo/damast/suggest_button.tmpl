{{/* DAMAST: toolbar button of review comment editors that inserts a ```suggestion block with the commented lines */}}
<div class="markdown-toolbar-group">
	<button type="button" class="markdown-toolbar-button damast-suggest" data-tooltip-content="{{ctx.Locale.Tr "damast.suggestions.suggest"}}" aria-label="{{ctx.Locale.Tr "damast.suggestions.suggest"}}" data-old-side-error="{{ctx.Locale.Tr "damast.suggestions.old_side"}}">{{svg "octicon-file-diff"}}</button>
</div>
